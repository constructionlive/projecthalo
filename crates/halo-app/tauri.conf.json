{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Halo",
  "version": "0.0.1",
  "identifier": "live.construction.halo",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build && node ../scripts/stage-kit.mjs",
      "cwd": "../../ui"
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "sky",
        "title": "Halo",
        "url": "index.html",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0A0B0A"
      },
      {
        "label": "summon",
        "url": "summon.html",
        "width": 860,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "resources": {
      "kit/": "kit/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzRUFBOUM1MDc5QTgwNzcKUldSM2dKb0h4YW5xOHc3T3NNL3VPMmlQcHpTejZjOWMxYStCVFdVMmtlSDN1SVNFU1ZoSEpoZHgK",
      "endpoints": [
        "https://pub-061018a047d54079b309fb16a26a1ce0.r2.dev/halo/latest.json"
      ]
    }
  }
}
